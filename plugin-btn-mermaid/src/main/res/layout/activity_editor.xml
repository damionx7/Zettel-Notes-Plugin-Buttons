<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
       android:id="@+id/editor_toolbar"
       android:layout_width="match_parent"
       android:layout_height="?attr/actionBarSize"
       app:navigationIcon="@drawable/ic_close"
       app:title="Mermaid" />

    <androidx.appcompat.widget.AppCompatEditText
       android:id="@+id/editor_text"
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:background="@null"
       android:fontFamily="monospace"
       android:gravity="top|start"
       android:hint="Type Mermaid code, or pick a template from the toolbar"
       android:importantForAutofill="no"
       android:inputType="textMultiLine|textNoSuggestions"
       android:padding="12dp"
       android:textSize="14sp" />

    <TextView
       android:id="@+id/editor_status"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:ellipsize="end"
       android:fontFamily="monospace"
       android:maxLines="3"
       android:paddingStart="12dp"
       android:paddingEnd="12dp"
       android:paddingBottom="6dp"
       android:textColor="?attr/colorError"
       android:textSize="12sp"
       android:visibility="gone" />

    <View
       android:layout_width="match_parent"
       android:layout_height="1dp"
       android:background="?attr/colorOutlineVariant" />

    <!-- Preview: white to match the white PNG background that gets inserted -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:background="#FFFFFF">

        <ScrollView
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           android:fillViewport="true">

            <ImageView
               android:id="@+id/preview_image"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:adjustViewBounds="true"
               android:contentDescription="Rendered diagram preview"
               android:padding="8dp"
               android:scaleType="fitCenter" />
        </ScrollView>

        <TextView
           android:id="@+id/preview_placeholder"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_gravity="center"
           android:text="Preview appears here"
           android:textColor="#757575" />

        <ProgressBar
           android:id="@+id/preview_progress"
           style="?android:attr/progressBarStyleSmall"
           android:layout_width="24dp"
           android:layout_height="24dp"
           android:layout_gravity="top|end"
           android:layout_margin="12dp"
           android:indeterminate="true"
           android:visibility="gone" />

        <!-- Render engine: 1dp and attached so JS runs unthrottled; output goes through the JS bridge, not the screen -->
        <WebView
           android:id="@+id/render_web_view"
           android:layout_width="1dp"
           android:layout_height="1dp"
           android:layout_gravity="bottom|start" />
    </FrameLayout>

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       android:padding="8dp">

        <com.google.android.material.button.MaterialButton
           android:id="@+id/btn_insert_image"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginEnd="4dp"
           android:layout_weight="1"
           android:text="Image" />

        <com.google.android.material.button.MaterialButton
           android:id="@+id/btn_insert_link"
           style="@style/Widget.Material3.Button.OutlinedButton"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginStart="4dp"
           android:layout_marginEnd="4dp"
           android:layout_weight="1"
           android:text="Link" />

        <com.google.android.material.button.MaterialButton
           android:id="@+id/btn_insert_code"
           style="@style/Widget.Material3.Button.OutlinedButton"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginStart="4dp"
           android:layout_weight="1"
           android:text="Code" />
    </LinearLayout>

</LinearLayout>